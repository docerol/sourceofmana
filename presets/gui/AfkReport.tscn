[gd_scene format=3]

[ext_resource type="Theme" path="res://data/themes/DefaultTheme.tres" id="1"]
[ext_resource type="Script" path="res://sources/gui/AfkReport.gd" id="2"]
[ext_resource type="PackedScene" path="res://presets/gui/TitleBar.tscn" id="3"]

[node name="AFK" type="PanelContainer"]
custom_minimum_size = Vector2(300, 240)
offset_right = 300.0
offset_bottom = 240.0
theme = ExtResource("1")
theme_type_variation = &"WindowPanel"
script = ExtResource("2")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="TitleBar" parent="Layout" instance=ExtResource("3")]
layout_mode = 2
size_flags_vertical = 0
titleText = "AFK Report"

[node name="Hours" type="Label" parent="Layout"]
layout_mode = 2
text = "Away: —"

[node name="XP" type="Label" parent="Layout"]
layout_mode = 2
text = "+0 XP"

[node name="Gold" type="Label" parent="Layout"]
layout_mode = 2
text = "+0 gold"

[node name="Drops" type="Label" parent="Layout"]
layout_mode = 2
text = "Drops: 0"

[node name="Chests" type="Label" parent="Layout"]
layout_mode = 2
text = "Chests: 0"

[node name="Efficiency" type="Label" parent="Layout"]
layout_mode = 2
text = "Efficiency: —"

[node name="Collect" type="Button" parent="Layout"]
layout_mode = 2
text = "Collect"

[connection signal="pressed" from="Layout/Collect" to="." method="_on_collect_pressed"]
