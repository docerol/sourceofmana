[gd_scene format=3]

[ext_resource type="Theme" path="res://data/themes/DefaultTheme.tres" id="1"]
[ext_resource type="Script" path="res://sources/gui/Chests.gd" id="2"]
[ext_resource type="PackedScene" path="res://presets/gui/TitleBar.tscn" id="3"]

[node name="Chests" type="PanelContainer"]
custom_minimum_size = Vector2(400, 400)
offset_right = 400.0
offset_bottom = 400.0
theme = ExtResource("1")
theme_type_variation = &"WindowPanel"
script = ExtResource("2")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="TitleBar" parent="Layout" instance=ExtResource("3")]
layout_mode = 2
size_flags_vertical = 0
titleText = "Chests"

[node name="LastDrop" type="Label" parent="Layout"]
layout_mode = 2
text = "Last drop: —"

[node name="Odds" type="Label" parent="Layout"]
layout_mode = 2
text = "Odds: —"
autowrap_mode = 3

[node name="ChestScroll" type="ScrollContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3

[node name="ChestList" type="VBoxContainer" parent="Layout/ChestScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Hint" type="Label" parent="Layout"]
layout_mode = 2
text = "Chests come from AFK settles. Buy more in the Shop."
autowrap_mode = 3
